# ——— Base de datos ———
# Local: SQLite en disco, sin credenciales. Arranca solo.
DB_PROVIDER=sqlite
DB_FILENAME=data/atv_roadmaps.db

# Server: Postgres de la Neon compartida del ecosistema, esquema propio.
# Misma convención que ecosystem / hiring / clients / ops.
# DB_PROVIDER=postgres
# DB_SCHEMA=roadmaps
# DB_HOST=
# DB_PORT=5432
# DB_USER=
# DB_PASS=
# DB_NAME=neondb
# DB_SSLMODE=require

# ——— ATV Clients (solo lectura) ———
# Los canales de Discord y los clientes salen del esquema `clients`.
# Aunque viva en la misma base, hay que setear el DSN aparte: el acceso por
# Pony a un segundo esquema falla (mismo gotcha que en ATV Ops).
# Vacío: la lista de canales queda vacía y se puede cargar el cliente a mano.
CLIENTS_DSN=

# ——— IA que genera el roadmap (Jeremy, utari.ai) ———
# POST con el formulario, respuesta con la estructura del roadmap.
# Contrato en docs/contrato-ia-jeremy.md.
# ROADMAP_AI_WEBHOOK_URL=https://api.utari.ai/v1/triggers/<trigger-id>/webhook
ROADMAP_AI_WEBHOOK_URL=
ROADMAP_AI_KEY=
# Cómo viaja la clave. utari.ai usa el valor pelado en x-webhook-secret;
# otros proveedores usan Authorization con prefijo "Bearer ".
ROADMAP_AI_AUTH_HEADER=x-webhook-secret
ROADMAP_AI_AUTH_PREFIJO=
ROADMAP_AI_TIMEOUT=180

# ——— Sesión ———
# MISMO valor que el SECRET de atv-ecosystem: así la cookie ecosystem_session
# que ya tiene el coach sirve acá sin volver a loguearse.
SECRET=cambiar-en-local
# Entrar sin la cookie del ecosistema. SOLO local: en el server tiene que
# quedar en 0 o cualquiera entra a la consola del coach sin sesión.
DEV_LOGIN=0

# ——— Público ———
# Base de los links que se le mandan al cliente.
PUBLIC_BASE_URL=http://localhost:5182

CORS_ORIGINS=http://localhost:5182,http://127.0.0.1:5182

# Local: canales desde el directorio de transcripts del bot (sin Neon).
# TRANSCRIPTS_BASE_PATH=

# Categorías de Discord que no son clientes (coma separada).
CATEGORIAS_IGNORADAS=updates

# Cuánto esperar el callback de la IA antes de darlo por perdido (minutos).
ROADMAP_AI_ESPERA_MAX_MIN=20
